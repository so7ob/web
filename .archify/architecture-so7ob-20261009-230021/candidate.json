  "cards": [
    {
      "dot": "cyan",
      "title": "الدخول والنتيجة",
      "items": [
        "الزائر: /ar أو /en؛ العميل: /{locale}/account؛ المدير: /{locale}/admin.",
        "SSR يطلب PublicView من PublicService داخل العملية ثم يعيد HTML وبيانات التهيئة؛ React ينفذ Hydration.",
        "التنقل اللاحق يقرأ /api/v1/public/view؛ عمليات الحساب والإدارة تستعمل REST وتعيد JSON عبر نفس اتصال الطلب."
      ]
    },
    {
      "dot": "rose",
      "title": "حماية حسب المسار",
      "items": [
        "جلسة خادم عبر Cookie؛ AccountGuard يرفض غيابها. Origin/CSRF يحمي الكتابة وفق السياسة؛ التفويض داخل الخدمات وPermissionGuard حسب المسار.",
        "العميل يصل إلى طلبه؛ الموظف يحتاج صلاحيات العرض والرد. الملاحظات الداخلية ومرفقاتها محجوبة عن العميل.",
        "المرفقات الخاصة: جلسة مستخدم أو Track capability صالحة وفق السياسة؛ media مسار عام مستقل. SSR العام يقرأ المنشور فقط."
      ]
    },
    {
      "dot": "emerald",
      "title": "العقود ليست قاعدة بيانات",
      "items": [
        "packages/contracts: أنواع الاستجابات والتحقق وقواعد الصلاحيات المشتركة؛ يستخدمها المتصفح والخادم كمكتبة.",
        "packages/server: كيانات التخزين وTypeORM DataSource/QueryRunner وSQL بمعاملات. لا اتصال من المتصفح إلى MariaDB.",
        "الخدمات تشمل المصادقة والعملاء والطلبات والاستفسارات والمحادثات والمستخدمين وCMS والملفات والإشعارات."
      ]
    },
    {
      "dot": "amber",
      "title": "غير متزامن بعد الحفظ",
      "items": [
        "MailJob وWebhookJob وFileCleanupJob جداول في MariaDB، وليست خدمة Queue منفصلة.",
        "العامل يسحب مع FOR UPDATE SKIP LOCKED وlease؛ البريد مشفر في الطابور؛ retry للأخطاء الآمنة وuncertain عند غموض الإرسال.",
        "العامل يفحص النشر المجدول أيضًا؛ لا يرسله الخادم كـMailJob. الإشعارات الداخلية سجلات Notification تُقرأ عبر API."
      ]
    },
    {
      "dot": "slate",
      "title": "مفتاح الأدلة والحدود",
      "items": [
        "الرمادي والأخضر المتصلان: طلب متزامن؛ الوردي المتقطع: تحقق متزامن؛ البنفسجي المتقطع: عمل خلفي؛ البنفسجي للصناديق: تخزين.",
        "كل مكوّن هنا منفذ في الكود؛ تفعيل SMTP/Webhook والنشر في الإنتاج غير متحقق. المصدر develop @ e84fe1b3.",
        "README يوثق ترحيلاً جزئيًا وقبولًا تشغيليًا غير مكتمل؛ Website وRakim مراجع فقط، والأرشيف reference ليس Runtime.",
        "التسميات عربية؛ أدوات عارض Archify الثابتة تستخدم واجهة إنجليزية. فصل العقود لا يثبت تنقية جميع API responses؛ انظر تقرير الأدلة."
      ]
    }
  ]
