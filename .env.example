# Synthetic local defaults. Never point development at Website production.
NODE_ENV=development
PORT=3108
BIND_HOST=127.0.0.1
SITE_URL=http://127.0.0.1:3108
WEB_ORIGIN=http://127.0.0.1:3108
TRUST_PROXY_HOPS=0
TZ=Asia/Aden
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_NAME=so7ob_migration
DATABASE_USER=so7ob_test
DATABASE_PASSWORD=replace-with-local-database-password
TEST_DATABASE_NAME=so7ob_schema_test
DATA_DIR=/var/lib/so7ob-web
# Supply independent secrets outside Git before production.
AUTH_SECRET=replace-with-independent-random-secret
OUTBOX_KEY=replace-with-base64-encoded-32-random-bytes
EMAIL_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_WEBHOOK_URL=
