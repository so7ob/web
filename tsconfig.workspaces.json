{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ],
    "paths": {
      "@so7ob/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@so7ob/server": [
        "./packages/server/src/index.ts"
      ],
      "@/*": [
        "./apps/web/src/*"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "**/dist",
    "node_modules",
    ".migration"
  ]
}
