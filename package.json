{
  "name": "so7ob-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "reference:dev": "next dev -p 3000 2>&1 | tee dev.log",
    "reference:build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "reference:start": "bun run scripts/start-production.ts",
    "reference:lint": "eslint src scripts tools *.ts *.mjs",
    "reference:typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "reference:test": "vitest run && bun test scripts/__tests__",
    "reference:db:seed": "bun run src/db/seed-roles.ts && bun run src/db/seed-content.ts",
    "dev": "npm run build:server && node --env-file-if-exists=.env apps/api/dist/main.js",
    "build": "tsc -b packages/contracts packages/server apps/api apps/worker && npm run build -w @so7ob/web",
    "typecheck": "tsc --noEmit -p tsconfig.workspaces.json",
    "lint": "eslint apps packages tools ops tests playwright.config.ts --max-warnings=0",
    "test": "vitest run --config vitest.workspaces.config.ts",
    "start": "node --env-file-if-exists=.env apps/api/dist/main.js",
    "start:worker": "node --env-file-if-exists=.env apps/worker/dist/main.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/server/src/database/cli.ts migrate",
    "db:check": "node --env-file-if-exists=.env --import tsx packages/server/src/database/cli.ts check",
    "test:e2e": "playwright test",
    "test:infra": "bash tools/test/infra.sh",
    "build:server": "tsc -b packages/contracts packages/server apps/api apps/worker",
    "data:transfer": "node --env-file-if-exists=.env --import tsx packages/server/src/migration/cli.ts",
    "data:backup": "node --env-file-if-exists=.env --import tsx packages/server/src/migration/backup-cli.ts",
    "test:worker": "node tools/migration/worker-smoke.mjs",
    "test:auth": "node tools/migration/auth-smoke.mjs",
    "test:webhook": "node tools/migration/webhook-smoke.mjs",
    "test:file-worker": "node tools/migration/file-worker-smoke.mjs",
    "site:init": "node --env-file-if-exists=.env --import tsx tools/development/initialize-site.ts",
    "admin:create": "node --env-file-if-exists=.env --import tsx tools/development/create-admin.ts",
    "test:restore": "node tools/migration/operational-restore.mjs",
    "data:recovery-check": "node --env-file-if-exists=.env --import tsx packages/server/src/migration/recovery-cli.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@reactuses/core": "6.1.9",
    "@tanstack/react-query": "5.90.19",
    "@tanstack/react-table": "8.21.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "12.26.2",
    "input-otp": "1.4.2",
    "lucide-react": "0.525.0",
    "next-themes": "0.4.6",
    "nodemailer": "10.0.13",
    "react": "19.2.8",
    "react-day-picker": "9.13.0",
    "react-dom": "19.2.8",
    "react-hook-form": "7.71.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "3.0.6",
    "react-syntax-highlighter": "15.6.6",
    "recharts": "2.15.4",
    "sharp": "0.34.5",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "tailwindcss-animate": "1.0.7",
    "uuid": "11.1.0",
    "vaul": "1.1.2",
    "zod": "4.3.5",
    "zustand": "5.0.10",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bcryptjs": "3.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.2",
    "jsdom": "30.1.1",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vite": "8.2.2",
    "@playwright/test": "1.62.1",
    "@axe-core/playwright": "4.13.0",
    "tsx": "4.20.5",
    "typescript-eslint": "8.46.1",
    "@types/node": "24.3.1",
    "@types/express": "5.0.3",
    "eslint-plugin-react-hooks": "5.2.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.21.0",
    "npm": "10.8.2"
  },
  "packageManager": "npm@10.8.2",
  "type": "module",
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.62.1"
    }
  }
}
